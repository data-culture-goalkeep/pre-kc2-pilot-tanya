# Set these values in the deployment environment; this file contains placeholders only.
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_OR_LEGACY_ANON_KEY

# Server-only. Store the real key in Vercel Environment Variables, never in source control.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Comma-separated email addresses allowed to manage invited users; keep empty until configured.
ADMIN_EMAILS=admin@example.com
